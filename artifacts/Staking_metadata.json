		"userdoc": {
			"kind": "user",
			"methods": {
				"FEE_BPS()": {
					"notice": "Fee taken on deposit AND on withdrawal, expressed in basis points (50 = 0.5%)."
				},
				"checkAccountReward()": {
					"notice": "Preview the reward currently owed to the caller."
				},
				"compoundReward()": {
					"notice": "If user wants to stake the deposit + reward again after the maturity of Stake then this function will be used to compound the staking again"
				},
				"depositToken(uint256,uint256)": {
					"notice": "Deposit tokens into a staking plan. amount Amount of tokens to stake (before fee). selectedPlan 0 = 30 days, 1 = 60 days, 2 = 90 days."
				},
				"getDetails()": {
					"notice": "View full details of the caller's stake."
				},
				"rescueTokens(address,uint256,address)": {
					"notice": "Recover ERC20 tokens accidentally sent to this contract. Cannot be used to pull out the staking token itself, so staked user funds can never be rug-pulled through this function."
				},
				"withdrawToken()": {
					"notice": "Withdraw principal + reward once the lock period has completed. NOTE: this design requires the plan to have fully matured before withdrawal."
				}
			},
			"notice": "Simple fixed-term staking contract with 30/60/90 day plans. But for testing purpose contract has seconds 300, 400,500 for now.",
